# ── copyfomo ────────────────────────────────────────────────────────────
# paper = simulated fills against real Jupiter quotes (safe default)
# live  = agents trade real SOL on mainnet. The worker REFUSES to start in live mode without PLATFORM_FEE_WALLET,
#         JUPITER_API_KEY with an https://api.jup.ag JUPITER_API_URL, and a seal key pair that matches
#         (WALLET_SEAL_PUBLIC_KEY here, WALLET_SEAL_PRIVATE_KEY in .env.worker).
COPYFOMO_MODE=paper
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite for local dev. For production use Postgres and change prisma provider.
DATABASE_URL="file:./dev.db"

# ── Solana RPC ──────────────────────────────────────────────────────────
# Public RPC is rate limited; use Helius / Triton / QuickNode for anything real.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=

# ── Jupiter (swaps, prices, token metadata) ─────────────────────────────
# lite-api.jup.ag is being retired. LIVE mode requires https://api.jup.ag + JUPITER_API_KEY (portal.jup.ag).
JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=
JUPITER_RPS=                # blank = 10 (lite-api) / 1 (api.jup.ag with a free key) / 0.5 (keyless api.jup.ag)
JUPITER_BURST=              # blank = 20 / 10 / 5
MAX_PRIORITY_FEE_LAMPORTS=2000000
PRIORITY_FEE_MAX_BPS=500    # a swap pays at most 5% of its SOL size in priority fee (sells 10%), floor below
PRIORITY_FEE_FLOOR_LAMPORTS=50000
MIN_LIVE_TRADE_SOL=0.01     # live copy buys below this are skipped (fees + token-account rent dominate)

# ── On-chain FOMO indexer (Helius) ─────────────────────────────
# FOMO trades are detected from public Solana data through this Helius key (no FOMO API).
# Never commit or print the key. Leave the budget knobs blank to use the plan's defaults.
HELIUS_API_KEY=
HELIUS_PLAN=free            # free | developer | business (budgets); features are auto-probed
FOMO_INDEXER=on
FOMO_MAX_TRACKED=           # blank = plan default (free 80, developer 2000, business 10000)
FOMO_BACKFILL_DAYS=         # blank = plan default (free 7, or 37 with gTFA; paid 37)
HELIUS_DAILY_CREDIT_CAP=    # blank = plan default (free 30000, developer 300000, business 3000000)
FOMO_DISCOVERY=             # off | sample | stream (blank = free/developer sample, business stream)
FOMO_RELAYERS=              # hotfix override; default AgmLJBMDCqWynYnQiPCuj9ewsNNsBJXyzoUhD9LJzN51
FOMO_MARKERS=               # hotfix override; default jitodontfront1111111111111111111TradeonFomo
COPY_VENUE=fomo             # fomo (copy FOMO buys only; sells of held sleeves from any venue) | all
SOL_PRICE_BACKFILL=binance  # binance | off

# ── Agent wallet sealing — generate with: npm run keys:gen
# Web process needs only the PUBLIC key (here). The PRIVATE key goes in .env.worker, which only
# `npm run worker` loads: Next.js never reads it, so it can't reach the web process or .next/cache.
# The web server refuses to run in live mode if WALLET_SEAL_PRIVATE_KEY is in its environment.
WALLET_SEAL_PUBLIC_KEY=
# WALLET_SEAL_PRIVATE_KEY=   ← in .env.worker, never here

# ── Wallet sign-in (web) ────────────────────────────────────────────────
# HMAC key for the session cookie: 32 random bytes, base64url (npm run keys:gen writes one). Never share it.
SESSION_SECRET=
# Where per-IP rate limits read the client IP: xff (entry TRUSTED_PROXY_HOPS from the RIGHT of X-Forwarded-For),
# or a header your proxy overwrites: x-real-ip | cf-connecting-ip | x-vercel-forwarded-for | fly-client-ip; none.
TRUSTED_IP_SOURCE=xff
TRUSTED_PROXY_HOPS=1

# ── Platform fee ────────────────────────────────────────────────────────
# Share of the realized profit on each winning copy sell (500 = 5%; 0..2000). Losing sells, buys,
# deposits and withdrawals pay nothing.
PLATFORM_FEE_BPS=500
# Live fees are swept here (base58). REQUIRED in live mode: the worker refuses to start without it.
PLATFORM_FEE_WALLET=
# Live: sweep owed fees once they reach this much SOL (always before a withdrawal).
FEE_SWEEP_MIN_SOL=0.01

# ── Limits ──────────────────────────────────────────────────────────────
MIN_DEPOSIT_SOL=0.05
PAPER_START_SOL=5
MAX_TRADERS_PER_AGENT=10
HARD_MAX_PER_TRADE_SOL=25

# ── Worker ──────────────────────────────────────────────────────────────
WORKER_POLL_MS=60000
WORKER_MAX_EVENT_AGE_MS=90000   # buys older than this are never copied; sells are copied up to 6 h old
# Operator hotfix only: extra program ids (comma-separated) the live swap guard allows, for when Jupiter or
# PumpPortal ship a new program before copyfomo is updated. It can never add System / Token / ATA / ComputeBudget.
WORKER_SWAP_EXTRA_PROGRAMS=
# LOG_LEVEL=info              # debug | info | warn | error
# WORKER_EXIT_AFTER_MS=       # graceful shutdown after N ms (CI, or Windows where SIGINT is awkward)
