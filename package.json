{
  "name": "copyfomo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.worker src/worker/index.ts",
