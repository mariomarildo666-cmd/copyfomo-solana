# copyfomo.secrets.env: provider keys and fee settings for the production server.
#
# Easiest: generate it from your local .env with   bash deploy/make-secrets.sh   (Git Bash), which writes
# ~/copyfomo.secrets.env with every setting except the ones production must generate itself.
# Upload it to /root/copyfomo.secrets.env and run deploy/setup.sh: setup imports it into /etc/copyfomo/web.env
# and then deletes it (shred). To rotate a key later, upload a file with just the changed lines and re-run setup.
#
# Never put these here (setup ignores them): WALLET_SEAL_PUBLIC_KEY, WALLET_SEAL_PRIVATE_KEY, SESSION_SECRET
# (generated fresh ON the server, never copied from dev), DATABASE_URL, NEXT_PUBLIC_SITE_URL, NODE_ENV,
# TRUSTED_IP_SOURCE, TRUSTED_PROXY_HOPS (set by setup), COPYFOMO_MODE (use copyfomo-set-mode).
# Values: one line each, no spaces or quotes inside the value. Empty values are ignored (the current value stays).

# free | developer | business (your Helius plan)
HELIUS_PLAN=
HELIUS_API_KEY=
# e.g. https://mainnet.helius-rpc.com/?api-key=<your key>
SOLANA_RPC_URL=
# e.g. wss://mainnet.helius-rpc.com/?api-key=<your key>
SOLANA_WS_URL=

# Live mode requires https://api.jup.ag and a key from portal.jup.ag
JUPITER_API_URL=
JUPITER_API_KEY=

# Public base58 address the live fees are swept to
PLATFORM_FEE_WALLET=
# 500 = 5% of the realized profit of each winning copy sell
PLATFORM_FEE_BPS=
FEE_SWEEP_MIN_SOL=
