# copyfomo web: Next.js (`next start`) on 127.0.0.1:3000, behind Caddy.
# Installed from deploy/systemd/ by setup.sh and copyfomo-update (local edits are overwritten: use
# `systemctl edit copyfomo-web` for a host-specific drop-in instead).
[Unit]
Description=copyfomo web (Next.js)
Documentation=file:///usr/local/lib/copyfomo/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=copyfomo
Group=copyfomo
# A symlink to the active release; resolved at start, so a running process keeps its own release directory.
WorkingDirectory=/opt/copyfomo/current
EnvironmentFile=/etc/copyfomo/web.env
# Defence in depth: the web process must never hold the seal private key (src/instrumentation.ts refuses to
# boot with it). setup.sh also refuses to write it into web.env.
UnsetEnvironment=WALLET_SEAL_PRIVATE_KEY
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=30
# New database files (-wal/-shm) must stay writable by the worker, which shares the copyfomo group.
UMask=0007
LimitNOFILE=65536
LimitCORE=0
SyslogIdentifier=copyfomo-web

# ── Sandbox ──────────────────────────────────────────────────────────────────────────────────────────
# Everything is read-only except the database directory: the web cannot modify the code the worker runs.
# Do NOT add MemoryDenyWriteExecute=yes: V8's JIT needs writable+executable pages.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/copyfomo
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
