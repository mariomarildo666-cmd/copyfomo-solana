# /etc/copyfomo/web.env: environment of copyfomo-web AND copyfomo-worker (systemd EnvironmentFile).
# Written by deploy/setup.sh from deploy/web.env.tmpl. root:copyfomo 0640.
#
#  - Format: KEY=value on one line. No quotes, no spaces, no inline comments: systemd reads the value literally.
#  - Re-running setup.sh keeps every value here, rewrites the [managed] lines, and imports the values of
#    /root/copyfomo.secrets.env (if present) over the others.
#  - After editing by hand: systemctl restart copyfomo-web copyfomo-worker (the worker stops gracefully).
#  - NEVER put WALLET_SEAL_PRIVATE_KEY here. It lives only in /etc/copyfomo/worker.env (root-only), which systemd
#    hands to the worker alone. The web process refuses to boot with it (src/instrumentation.ts).

# ── [managed] by setup.sh ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=file:/var/lib/copyfomo/copyfomo.db
NEXT_PUBLIC_SITE_URL=https://__DOMAIN__
# Caddy is the only proxy: it replaces any client-sent X-Forwarded-For with the real peer address, so the
# rightmost (only) entry is the client. The web listens on 127.0.0.1 only, so nothing can bypass Caddy.
TRUSTED_IP_SOURCE=xff
TRUSTED_PROXY_HOPS=1
# Seal PUBLIC key (the web seals new agent keys with it). Generated once on this server, never rotated.
WALLET_SEAL_PUBLIC_KEY=
# Wallet sign-in cookie HMAC key. Generated once; rotating it only signs everyone out.
SESSION_SECRET=

# ── Mode: paper | live. Change it ONLY with: copyfomo-set-mode paper|live ─────────────────────────────────
COPYFOMO_MODE=paper

# ── Solana RPC (Helius). These URLs contain the Helius key. ─────────────────────────────────────────────
SOLANA_RPC_URL=
SOLANA_WS_URL=

# ── Jupiter. Live mode requires https://api.jup.ag + JUPITER_API_KEY. Blank = the app's defaults. ──────────
JUPITER_API_URL=
JUPITER_API_KEY=
JUPITER_RPS=
JUPITER_BURST=
MAX_PRIORITY_FEE_LAMPORTS=2000000
PRIORITY_FEE_MAX_BPS=500
PRIORITY_FEE_FLOOR_LAMPORTS=50000
MIN_LIVE_TRADE_SOL=0.01

# ── On-chain FOMO indexer (Helius) ─────────────────────────────────────────────────────────────────────
HELIUS_API_KEY=
HELIUS_PLAN=free
FOMO_INDEXER=on
FOMO_MAX_TRACKED=
FOMO_BACKFILL_DAYS=
HELIUS_DAILY_CREDIT_CAP=
FOMO_DISCOVERY=
FOMO_RELAYERS=
FOMO_MARKERS=
COPY_VENUE=fomo
SOL_PRICE_BACKFILL=binance

# ── Platform fee ───────────────────────────────────────────────────────────────────────────────────────
PLATFORM_FEE_BPS=500
# Live fees are swept here (public base58 address). Required for live mode. Keep >= ~0.001 SOL in it.
PLATFORM_FEE_WALLET=
FEE_SWEEP_MIN_SOL=0.01

# ── Limits ─────────────────────────────────────────────────────────────────────────────────────────────
MIN_DEPOSIT_SOL=0.05
PAPER_START_SOL=5
MAX_TRADERS_PER_AGENT=10
HARD_MAX_PER_TRADE_SOL=25

# ── Worker ─────────────────────────────────────────────────────────────────────────────────────────────
WORKER_POLL_MS=60000
WORKER_MAX_EVENT_AGE_MS=90000
WORKER_SWAP_EXTRA_PROGRAMS=
LOG_LEVEL=info
