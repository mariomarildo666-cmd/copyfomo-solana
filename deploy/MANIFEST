# deploy/MANIFEST: what setup.sh and copyfomo-update install on the server. It is read from the kit being
# installed (not from the installed one), so a commit can add, rename or drop files here. One entry per line:
#   cmd     script: installed to /usr/local/lib/copyfomo and linked as /usr/local/sbin/copyfomo-<name without .sh>
#   file    installed to /usr/local/lib/copyfomo (library, templates, docs)
#   unit    systemd unit copied to /etc/systemd/system (started by another unit or a timer)
#   enable  systemd unit copied to /etc/systemd/system and enabled
# Anything not listed (make-secrets.sh, pull-backups.ps1: they run on your PC) is never installed, and neither is
# an env or secrets file left next to the scripts.
cmd     setup.sh
cmd     update.sh
cmd     status.sh
cmd     backup.sh
cmd     restore.sh
cmd     set-mode.sh
cmd     offsite.sh
file    lib.sh
file    MANIFEST
file    web.env.tmpl
file    Caddyfile.tmpl
file    github_known_hosts
file    secrets.env.example
file    README.md
enable  systemd/copyfomo-web.service
enable  systemd/copyfomo-worker.service
unit    systemd/copyfomo-backup.service
enable  systemd/copyfomo-backup.timer
